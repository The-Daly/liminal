{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Social Rule",
  "type": "object",
  "required": [
    "social_rule_id",
    "display_name",
    "friendly_fire",
    "squad_rules",
    "radio_rules"
  ],
  "properties": {
    "social_rule_id": { "type": "string" },
    "display_name": { "type": "string" },
    "friendly_fire": {
      "type": "object",
      "required": [
        "same_faction_damage_enabled",
        "same_squad_damage_enabled",
        "team_kill_enabled",
        "description"
      ],
      "properties": {
        "same_faction_damage_enabled": { "type": "boolean" },
        "same_squad_damage_enabled": { "type": "boolean" },
        "team_kill_enabled": { "type": "boolean" },
        "description": { "type": "string" }
      }
    },
    "squad_rules": {
      "type": "object",
      "required": [
        "same_faction_only",
        "max_members",
        "shared_visibility_channels",
        "description"
      ],
      "properties": {
        "same_faction_only": { "type": "boolean" },
        "max_members": { "type": "integer", "minimum": 1 },
        "shared_visibility_channels": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["Radio", "TrailString", "SquadPing", "QuestIntent"]
          }
        },
        "description": { "type": "string" }
      }
    },
    "radio_rules": {
      "type": "object",
      "required": [
        "connects_scope",
        "requires_radio_item",
        "cross_faction_allowed",
        "description"
      ],
      "properties": {
        "connects_scope": {
          "type": "string",
          "enum": ["SquadOnly", "FactionWide", "LocalProximity"]
        },
        "requires_radio_item": { "type": "boolean" },
        "cross_faction_allowed": { "type": "boolean" },
        "description": { "type": "string" }
      }
    },
    "description": { "type": "string" }
  }
}
