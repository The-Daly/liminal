{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Item",
  "type": "object",
  "required": [
    "item_id",
    "display_name",
    "category",
    "rarity",
    "stackable",
    "can_be_lost_on_death"
  ],
  "properties": {
    "item_id": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "rarity": {
      "type": "string",
      "enum": [
        "Common",
        "Uncommon",
        "Rare",
        "VeryRare",
        "RelicClass",
        "Quest"
      ]
    },
    "stackable": {
      "type": "boolean"
    },
    "max_stack": {
      "type": "integer",
      "minimum": 1
    },
    "weight": {
      "type": "number",
      "minimum": 0
    },
    "value_tickets": {
      "type": "integer",
      "minimum": 0
    },
    "can_be_lost_on_death": {
      "type": "boolean"
    },
    "can_display_in_room": {
      "type": "boolean"
    },
    "display_location": {
      "type": [
        "string",
        "null"
      ]
    },
    "faction_restriction": {
      "type": [
        "string",
        "null"
      ]
    },
    "description": {
      "type": "string"
    }
  }
}
