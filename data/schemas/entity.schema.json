{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Entity",
  "type": "object",
  "required": [
    "entity_id",
    "display_name",
    "role",
    "mvp_behavior"
  ],
  "properties": {
    "entity_id": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "mvp_behavior": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "counterplay": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
