{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quest",
  "type": "object",
  "required": ["quest_id", "display_name", "giver_npc_id", "objectives", "rewards"],
  "additionalProperties": false,
  "properties": {
    "quest_id": { "type": "string" },
    "display_name": { "type": "string" },
    "giver_npc_id": { "type": "string" },
    "objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["objective_type", "item_id", "quantity"],
        "additionalProperties": false,
        "properties": {
          "objective_type": {
            "type": "string",
            "enum": ["ExtractWithItem", "ContributeItem", "VisitLocation"]
          },
          "item_id": { "type": "string" },
          "quantity": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "rewards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item_id", "quantity"],
        "additionalProperties": false,
        "properties": {
          "item_id": { "type": "string" },
          "quantity": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "description": { "type": "string" }
  }
}
