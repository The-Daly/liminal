{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trader",
  "type": "object",
  "required": ["trader_id", "display_name", "stock"],
  "additionalProperties": false,
  "properties": {
    "trader_id": { "type": "string" },
    "display_name": { "type": "string" },
    "location_id": { "type": "string" },
    "stock": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item_id", "price_tickets"],
        "additionalProperties": false,
        "properties": {
          "item_id": { "type": "string" },
          "price_tickets": { "type": "integer", "minimum": 0 },
          "max_quantity": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "description": { "type": "string" }
  }
}
